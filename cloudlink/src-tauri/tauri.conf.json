{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CloudLink",
  "version": "0.2.0",
  "identifier": "com.cloudlink.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm build:guard && pnpm dev",
    "beforeBuildCommand": "pnpm build:guard && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "CloudLink",
        "width": 1000,
        "height": 680,
        "decorations": true,
        "minWidth": 760,
        "minHeight": 520,
        "zoomHotkeysEnabled": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5173 ws://127.0.0.1:5173",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/cloudlink-guard"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1M0EwNEU5NzNGMDBDRjAKUldUd0RQQno2UVE2dFhFTXNyY1FUUjlVWHQ0NjNoRXdHVnhxa1MwRXcwL2c4aFRacGtqMTRleDIK",
      "endpoints": [
        "https://github.com/Furina-he/cloudlink/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
